# Environment variables for Printing & Signage Backend

# Application
PORT=5000
NODE_ENV=development
API_PREFIX=api/v1
APP_URL=http://localhost:5000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signage_db?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_signage_production_key_2026_x99!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_signage_production_key_2026_y88!
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_MB=25

# Geofence & Location Default (Factory/Shop Location)
DEFAULT_SHOP_LATITUDE=19.0760
DEFAULT_SHOP_LONGITUDE=72.8777
DEFAULT_GEOFENCE_RADIUS_METERS=200

# WhatsApp Integration (WATI / Gupshup / WhatsApp Cloud API)
WHATSAPP_PROVIDER=MOCK
WHATSAPP_API_URL=https://api.wati.io/api/v1
WHATSAPP_API_KEY=mock_wati_api_key
WHATSAPP_PHONE_NUMBER_ID=mock_whatsapp_number_id

# SMS Provider (Fast2SMS / Twilio)
SMS_PROVIDER=MOCK
FAST2SMS_API_KEY=mock_fast2sms_api_key

# Google Maps API Key
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=mock_fcm_server_key
